# Copy to .env if needed.
# POST /v1/generate 使用 AG-UI RunAgentInput。
# 默认 SSE：RUN_* / ACTIVITY_SNAPSHOT。?sse=0 改为一次性 JSON。
# 有 DASHSCOPE_API_KEY 时走 DashScope 兼容模式；否则用 mock。

PORT=3000
A2UI_SSE_INTERVAL_MS=160
# 生成界面时提高上限，避免复杂页写到标题就被截断。
A2UI_MAX_TOKENS=8192

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-image-plus
# 多语言出界面 / 对话。留空则回退 DASHSCOPE_MODEL。
DASHSCOPE_MODEL2=qwen3.8-flash
# 可选。文生图专用；不设时：DASHSCOPE_MODEL 若是 qwen-image / wanx 则用它，否则 qwen-image-plus。
# DASHSCOPE_IMAGE_MODEL=qwen-image-plus
# Max / 思考模型默认会先长推理，界面会卡在「生成中」。默认关掉思考；设为 1 才打开。
# A2UI_ENABLE_THINKING=1
# 带图 generate 时优先用视觉模型；留空则仍走 DASHSCOPE_MODEL。
DASHSCOPE_VL_MODEL=qwen-vl-plus

# 基础模型对话 POST /v1/chat（Playground「仅测试模型对话」）
# 默认一次性 JSON { reply }；Accept: text/event-stream 或 ?sse=1 则流式 CHAT_STARTED / CHAT_DELTA / CHAT_FINISHED。
# 优先用 OPENAI_*；留空则回退上面的 DASHSCOPE_*。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VL_MODEL=gpt-4o-mini
