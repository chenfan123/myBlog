    },
    {
      "dataModelUpdate": {
        "surfaceId": "login-form",
        "contents": [
          {
            "key": "status",
            "valueString": "Sign in to continue"
          },
          {
            "key": "email",
            "valueString": "demo@a2ui.dev"
          },
          {
            "key": "password",
            "valueString": "secret"
          }
        ]
      }
