              }
            }
          },
          {
            "id": "title",
            "component": {
              "Text": {
                "text": {
                  "path": "/headline",
                  "literalString": "Welcome back"
                },
                "usageHint": "h2"
              }
            }
          },
          {
            "id": "subtitle",
            "component": {
              "Text": {
                "text": {
                  "path": "/status"
                },
                "usageHint": "caption"
              }
            }
          },
          {
            "id": "email-field",
            "component": {
              "TextField": {
                "label": {
                  "literalString": "Email"
                },
                "text": {
                  "path": "/email"
                }
              }
            }
          },
          {
            "id": "password-field",
            "component": {
              "TextField": {
                "label": {
                  "literalString": "Password"
                },
                "text": {
                  "path": "/password"
                },
                "textFieldType": "obscured"
              }
            }
          },
          {
            "id": "login-btn-text",
            "component": {
