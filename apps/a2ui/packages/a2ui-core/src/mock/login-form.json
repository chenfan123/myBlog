          },
          {
            "id": "login-btn",
            "component": {
              "Button": {
                "child": "login-btn-text",
                "primary": true,
                "action": {
                  "name": "login",
                  "context": [
                    {
                      "key": "email",
                      "value": {
                        "path": "/email"
                      }
                    },
                    {
                      "key": "password",
                      "value": {
                        "path": "/password"
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
