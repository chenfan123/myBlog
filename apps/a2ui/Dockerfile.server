FROM node:22-alpine

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY docs ./docs
COPY server ./server

RUN pnpm install --frozen-lockfile

EXPOSE 3000
CMD ["pnpm", "--filter", "a2ui-playground-server", "start"]
