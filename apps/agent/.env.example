# 复制为 .env（不要提交真实密钥）
DATABASE_URL=postgresql+psycopg://myblog:myblog_local@localhost:5432/myblog

# 对话模型（OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Embedding 模型
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-3-large

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_DB=zy91_triage
MILVUS_COLLECTION=dept_chunks
MILVUS_DOCTOR_COLLECTION=doctor_profiles
MILVUS_DEPT_HIER_COLLECTION=dept_chunks_hierarchical
MILVUS_MAPPING_COLLECTION=dept_symptom_mappings

# Rerank（可选）
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank
RERANK_TOP_N=5
RERANK_TIMEOUT=30
RERANK_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.
