APP_NAME="MyBlog API"
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DATABASE_URL=postgresql+psycopg://myblog:myblog_local@localhost:5432/myblog
AUTH_SECRET=development-only-auth-secret-change-before-deploy
AUTH_COOKIE_NAME=myblog_access_token
AUTH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=管理员
# 阿里云验证码 2.0（前两项同时供前端初始化使用）
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_EKEY=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
CAPTCHA_REQUIRED=true
CAPTCHA_LOG_RETENTION_DAYS=7
CAPTCHA_LOG_CLEANUP_INTERVAL_SECONDS=86400
# Redis配置
REDIS_URL=redis://localhost:6379/0
# 邮箱配置
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
EMAIL_CODE_EXPIRE_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=50
EMAIL_CODE_MAX_ATTEMPTS=5
